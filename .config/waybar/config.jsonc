{
    "layer": "top",
    "width": 1000,
    "modules-left": [
        "pulseaudio",
        "custom/media"
    ],
    "modules-center": [
        "clock",
        "hyprland/workspaces",
        "clock#1"
    ],
    "modules-right": [
        "custom/cava",
        "network",
        "backlight"
    ],
    "clock": {
        "format": "{:%H}"
    },
    "clock#1": {
        "format": "{:%M}"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": ""
        }
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "󰝟 0%",
        "format-icons": {
            "headphone": "",
            "headset": "󰋎",
            "default": [
                "󰕿",
                "󰕾"
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },
    "custom/media": {
        "format": "{text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃝",
            "󰃠",
            "󰃡"
        ]
    },
    "network": {
        "interface": "wlan0",
        "format": "{ifname}",
        "format-wifi": "󰤥 Connected",
        "format-ethernet": " {ifname}",
        // "format-disconnected": "", //An empty format will hide the module.
        "format-disconnected": "󰤮 Disconnected",
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        // "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    },
    "custom/cava": {
    "exec": "stdbuf -oL cava -p ~/.config/cava/config_waybar | stdbuf -oL sed -u 's/0/ /g; s/1/▁/g; s/2/▂/g; s/3/▃/g; s/4/▄/g; s/5/▅/g; s/6/▆/g; s/7/▇/g; s/8/█/g; s/;//g'",
    "format": "{}",
    "return-type": "raw"
}
}
